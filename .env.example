# Copy this file to .env and adjust values as needed.
# These override the corresponding config.yaml defaults (see config.py).

# Dataset locations (used if you don't want to edit configs/config.yaml directly)
BTC_TRAIN_DIR=data/raw/Training
BTC_TEST_DIR=data/raw/Testing

# Set to "1" to force CPU-only execution even if a GPU is available
CUDA_VISIBLE_DEVICES=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
